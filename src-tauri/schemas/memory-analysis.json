{
  "type": "object",
  "required": [
    "conversation_summary",
    "task_outcome",
    "decisions",
    "artifacts",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "conversation_summary": {
      "type": "string",
      "maxLength": 2400
    },
    "task_outcome": {
      "type": "string",
      "maxLength": 1200
    },
    "decisions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "content",
          "scope",
          "confidence",
          "importance",
          "rationale",
          "source_message_ids",
          "evidence",
          "supersedes"
        ],
        "properties": {
          "type": {
            "enum": [
              "preference",
              "fact",
              "person",
              "project",
              "decision",
              "procedure",
              "path_resource",
              "recurring_context",
              "lesson",
              "tool_usage_preference"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "scope": {
            "enum": [
              "global",
              "project"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string",
            "maxLength": 300
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "source_message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "message_id",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "message_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "quote": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 2000
                }
              }
            }
          }
        }
      }
    }
  }
}
