{
  "identifier": "alfredpet-desktop",
  "description": "AlfredPet window operations; sensitive operations use Rust policy",
  "windows": ["pet", "chat", "bubble", "command_palette", "history", "settings", "activity", "permission", "capture_overlay", "task_center"],
  "permissions": ["core:default", "core:window:allow-start-dragging", "core:window:allow-hide", "core:window:allow-close", "core:window:allow-set-focus", "core:window:allow-set-position", "core:window:allow-outer-position", "core:window:allow-outer-size", "core:window:allow-current-monitor", "core:window:allow-available-monitors", "autostart:default"]
}
